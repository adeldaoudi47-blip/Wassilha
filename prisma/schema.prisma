// WASSILHA (ظˆظژطµظگظ‘ظ„ظ‡ط§) â€” Local triporteur delivery platform for El Guerrara, Ghardaأ¯a
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  email         String?  @unique
  passwordHash  String?
  phoneVerified Boolean  @default(false)
  // accountStatus values:
  //   "incomplete" â€” phone verified, signup form not yet completed (customer path)
  //   "pending"    â€” driver self-registration submitted, awaiting admin approval
  //   "active"     â€” fully usable account (customer, approved driver, admin)
  //   "rejected"   â€” driver application was rejected by admin
  accountStatus String   @default("incomplete")
  role          String   @default("customer") // customer | driver | admin
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders       Order[]     @relation("CustomerOrders")
  drivenOrders Order[]     @relation("DriverOrders")
  ratingsGiven Rating[]    @relation("Rater")
  ratingsRecv  Rating[]    @relation("Ratee")
  // TRIP OFFERS: a customer can book one or more trip offers
  // offered by drivers. Tracked separately from the resulting
  // Order (which lives in `orders` above) so that we can render
  // "offers you have booked" without joining through Order.
  bookedOffers TripOffer[] @relation("TripOfferBooker")
  driver       Driver?
  sessions     Session[]
  pushTokens   PushToken[]
}

/// Server-side session store. Only the SHA-256 hash of the session token is
/// persisted â€” the raw token lives exclusively in the user's httpOnly cookie.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Generic fixed-window rate-limit buckets (e.g. "otpsend:ip:1.2.3.4").
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model Driver {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One-to-One with the driver's vehicle registration (carte grise).
  // Kept optional so that admin-created drivers without a carte grise remain
  // valid (legacy rows preserved).
  vehicleRegistrationId String?              @unique
  vehicleRegistration   VehicleRegistration? @relation(fields: [vehicleRegistrationId], references: [id], onDelete: SetNull)
  isOnline              Boolean              @default(false)
  isVerified            Boolean              @default(true)
  // Last known GPS position broadcasted by the driver's mobile/web app.
  // Persisted on the Driver row so that we have a current position to send
  // to customers (after a fresh page load) and to admin (fleet view) even
  // before the next socket.io tick arrives.
  currentLat            Float?
  currentLng            Float?
  // Timestamp of the last position fix. Stale rows (e.g. lastSeenAt > 60s ago)
  // should be treated as "offline" by the UI regardless of `isOnline`.
  lastSeenAt            DateTime?
  // applicationStatus reflects the self-registration workflow:
  //   "pending"  â€” driver submitted an application, awaiting admin approval
  //   "active"   â€” admin approved the driver; full driver privileges
  //   "rejected" â€” admin rejected the application
  // Admin-created drivers continue to default to "active" (existing rows preserved).
  applicationStatus     String               @default("active")
  // Service type — which kinds of orders this driver is willing to
  // accept. Stored as a free String to avoid a Prisma enum (which
  // would require a migration on every change). Allowed values:
  //   "CARGO"  → goods / parcels / furniture / ... (the original
  //              triporteur-only flow)
  //   "TAXI"   → passenger transport (Yassir-like)
  //   "BOTH"   → driver wants both kinds of orders
  // Old rows default to "CARGO" so the post-migration state matches
  // the pre-migration behavior (everyone gets the legacy cargo fan-out).
  // The order-fan-out query in `POST /api/orders` filters drivers by
  // this column so a cargo driver never receives a taxi ping and a
  // taxi driver never receives a cargo ping.
  serviceType           String               @default("CARGO")
  appliedAt             DateTime?

  // TRIP OFFERS: a driver can publish pre-planned trips (taxi
  // ride, cargo run) so that customers can browse them and book
  // directly. Back-relation of TripOffer.driver.
  offers                TripOffer[]
  reviewedAt            DateTime?
  rating                Float                @default(5.0)
  totalTrips            Int                  @default(0)
  totalEarnings         Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // SECURITY (V14): isOnline/isVerified back the driver fan-out
  // (`where: { isOnline: true, isVerified: true, ... }`).
  @@index([isOnline])
  @@index([isVerified])
  @@index([isOnline, isVerified])
  // Service-type filter: the order POST handler uses
  // `serviceType IN ('BOTH', <request-type>)` to exclude drivers who
  // don't serve a given category (e.g. cargo-only drivers never
  // receive a `taxi` ping). A compound index with the two flags
  // keeps the fan-out cheap even as the driver pool grows.
  @@index([isOnline, isVerified, serviceType])
}

/// Carte grise (vehicle registration document) for a driver. The OwnerType
/// enum determines which owner-name fields are required at the API layer:
///   - PERSONNE_PHYSIQUE requires `nom` + `prenom`
///   - PERSONNE_MORALE   requires `raisonSociale`
enum OwnerType {
  PERSONNE_PHYSIQUE
  PERSONNE_MORALE
}

model VehicleRegistration {
  id                            String    @id @default(cuid())
  // Algerian registration number (e.g. "12345-A-06"). Required, unique.
  numeroImmatriculation         String    @unique
  // Type of legal owner of the vehicle.
  typeProprietaire              OwnerType
  // Required for PERSONNE_PHYSIQUE, null for PERSONNE_MORALE.
  nom                           String?
  prenom                        String?
  // Required for PERSONNE_MORALE, null for PERSONNE_PHYSIQUE.
  raisonSociale                 String?
  // Brand / make of the vehicle (e.g. "TVS", "Bajaj", "Piaggio").
  marque                        String
  // Detailed vehicle type / model (free-form). Optional.
  type                          String?
  // Year the vehicle was first put into service (e.g. 2021).
  anneePremiereMiseCirculation  Int
  // Carte-grisse â€” full date (or free-form text) when the vehicle was
  // first put into service. Optional, complements `anneePremiereMiseCirculation`.
  datePremiereMiseEnCirculation String?
  // Carte-grisse â€” current residential address of the vehicle owner.
  adresse                       String?
  // Carte-grisse â€” F.2: poids total autorisأ© en charge (PTAC, kg).
  ptac                          String?
  // Carte-grisse â€” G.1: poids أ  vide (kg).
  poidsAVide                    String?
  // Carte-grisse â€” P.3: type d'أ©nergie / fuel type (Benzine, Diesel, GPL).
  energie                       String?
  // Carte-grisse â€” P.2: puissance administrative / fiscale (CV).
  puissance                     String?
  // Chassis / serial number fields are intentionally NOT exposed in the
  // driver-facing form (privacy + verification happens off-platform). They
  // are kept in the schema for future use.
  numeroSerie                   String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  driver Driver?

  @@index([numeroImmatriculation])
}

model Vehicle {
  id           String   @id @default(cuid())
  driverId     String   @unique
  type         String
  color        String
  plateNumber  String?
  capacityKg   Int      @default(500)
  registeredAt DateTime @default(now())
}

model Order {
  id          String    @id @default(cuid())
  code        String    @unique // human-friendly WS-XXXXX
  customerId  String
  customer    User      @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId    String?
  driver      User?     @relation("DriverOrders", fields: [driverId], references: [id])
  cargoType   String // parcel | goods | shop | furniture | appliance | construction | personal | other
  pickup      String
  dropoff     String
  pickupLat   Float     @default(32.7833)
  pickupLng   Float     @default(3.7667)
  dropoffLat  Float     @default(32.7900)
  dropoffLng  Float     @default(3.7800)
  weight      Int       @default(20)
  distance    Float     @default(3.0)
  price       Int       @default(300)
  status      String    @default("searching") // searching | scheduled | accepted | picked | delivered | cancelled
  notes       String?
  rating      Int?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  pickedAt    DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  // SCHEDULED BOOKINGS: when set, the order is a future reservation
  // and the API should set status='scheduled' instead of 'searching'.
  // Null = immediate order (the historical default). A future time
  // = the customer wants a triporteur / taxi at a specific moment;
  // the driver fan-out is delayed until the dispatcher flips it to
  // 'searching' when the time approaches.
  scheduledAt  DateTime?

  ratings Rating[]

  // TRIP OFFERS: when an order is created from a booked TripOffer
  // the offer stores a pointer back to the resulting order so that
  // admins can trace "this order came from this offer" without
  // joining through the customer.
  tripOffer TripOffer?

  // SECURITY (V14): indexes for hot queries. customerId/driverId are
  // used by /api/orders GET to scope the listing. status and the
  // (status, createdAt) compound back the driver fan-out query that
  // picks the next available order. createdAt backs the dashboard
  // ordering.
  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  // Scheduled bookings: the dispatcher job (out of scope here) and
  // the driver's "incoming scheduled" tab both filter by
  // (scheduledAt ASC) when status='scheduled'.
  @@index([scheduledAt])
}

/// A pre-published trip a driver advertises so that customers can
/// browse it and book it directly. Mirrors the columns a customer
/// would otherwise enter on the order form (pickup, dropoff,
/// scheduledAt, price, serviceType) plus booking state
/// (`status`, `bookerId`, `orderId`).
///
/// - `serviceType` is one of "TAXI" / "CARGO" and is intentionally
///   free (no Prisma enum) to match the existing `Driver.serviceType`
///   column and to allow future categories (e.g. "DELIVERY") without
///   a migration. The driver-side POST validates the value against an
///   allowlist before insert.
/// - `seatsAvail` is for TAXI offers (number of seats still free).
///   For CARGO offers it is null.
/// - `cargoType` is for CARGO offers (parcel / goods / shop /
///   furniture / appliance / construction / personal / other — same
///   vocabulary as `Order.cargoType`). For TAXI offers it is null.
/// - `status` lifecycle:
///     "available" — open for booking
///     "booked"    — a customer claimed it (an Order has been
///                    created and `orderId` is set)
///     "cancelled" — driver pulled the offer
///   Free string to stay consistent with `Order.status` and
///   `Driver.applicationStatus` (no Prisma enum).
/// - `bookerId` / `booker` → the customer who booked it (nullable
///   while the offer is still available). `onDelete: SetNull` so
///   that deleting the customer doesn't cascade-delete the offer
///   (the offer becomes orphaned, which admin can clean up).
/// - `orderId` / `order` → the Order created when the offer was
///   booked. `@unique` because each offer can be booked at most
///   once. `onDelete: SetNull` so the offer survives a later
///   deletion of the order.
model TripOffer {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  serviceType String
  pickup      String
  dropoff     String
  scheduledAt DateTime
  price       Int
  seatsAvail  Int?
  cargoType   String?
  status      String   @default("available")
  bookerId    String?
  booker      User?    @relation("TripOfferBooker", fields: [bookerId], references: [id], onDelete: SetNull)
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // driverId: "my offers" listing on the driver side.
  @@index([driverId])
  // status: customer browse filters by `status='available'` and
  // the dispatcher / driver UI filter on `status='booked'`.
  @@index([status])
  // scheduledAt: customer browse sorts by upcoming departures.
  @@index([scheduledAt])
  // Compound (status, scheduledAt) backs the customer listing
  // `where: { status: 'available', scheduledAt: { gt: now } }`
  // with a single index scan.
  @@index([status, scheduledAt])
  // Compound (serviceType, status) backs the per-category browse
  // (TAXI vs CARGO) which is the common path.
  @@index([serviceType, status])
}

model Pricing {
  id          String   @id @default("default")
  basePrice   Int      @default(150)
  perKm       Int      @default(60)
  multipliers String   @default("{\"parcel\":1.0,\"goods\":1.1,\"shop\":1.0,\"furniture\":1.5,\"appliance\":1.4,\"construction\":1.8,\"personal\":1.0,\"other\":1.0}")
  updatedAt   DateTime @updatedAt
}

model Rating {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromId    String
  from      User     @relation("Rater", fields: [fromId], references: [id])
  toId      String
  to        User     @relation("Ratee", fields: [toId], references: [id])
  score     Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  // SECURITY (V14): toId is the primary key for the SQL aggregate
  // in /api/orders/:id/deliver. orderId backs the per-order rating
  // lookup. fromId backs the per-customer "ratings I gave" view.
  @@index([toId])
  @@index([orderId])
  @@index([fromId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  // SECURITY (V14): expiresAt backs the cleanup cron (V13) that prunes
  // expired OTPs. (phone, expiresAt) backs the latest-valid lookup.
  @@index([expiresAt])
  @@index([phone, expiresAt])
}

/// Geographic delivery taxonomy. Used by the new "neighbourhood + drop point"
/// picker so that customers can pick a specific landmark (mosque, school,
/// pharmacy, ...) inside one of the 41 neighbourhoods of El Guerrara. The
/// enum is intentionally permissive (we accept mistypes like RESTAURANT or
/// SHOP even though the seed only fills a subset) so that future admin
/// edits do not require a migration.
enum DeliveryPointType {
  AREA
  MOSQUE
  SCHOOL
  UNIVERSITY
  HEALTH
  PHARMACY
  POST
  ADMINISTRATION
  POLICE
  CIVIL_PROTECTION
  MARKET
  RESTAURANT
  SHOP
  FACTORY
  ARTISANAL
  CEMETERY
  YOUTH_CENTER
  TRANSPORT
  OTHER
}

/// A neighbourhood (ï؟½ï؟½) of El Guerrara. Slugs are unique and used by the
/// admin UI to deep-link to a specific area. The relation to DeliveryPoint
/// uses onDelete: Cascade so that dropping an area also drops its points.
model DeliveryArea {
  id        String          @id @default(cuid())
  nameAr    String
  nameFr    String?
  slug      String          @unique
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  points    DeliveryPoint[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

/// A specific delivery landmark inside a DeliveryArea. Latitude/longitude
/// are nullable on purpose: the seed dataset only contains verified coords
/// for a small subset, and we want the data layer to remain honest. When
/// the picker returns a point without coords the UI falls back to
/// GUERRARA_CENTER (32.7833, 3.7667) so that the order can still be priced
/// and dispatched.
model DeliveryPoint {
  id         String            @id @default(cuid())
  areaId     String
  area       DeliveryArea      @relation(fields: [areaId], references: [id], onDelete: Cascade)
  nameAr     String
  nameFr     String?
  type       DeliveryPointType
  latitude   Decimal?          @db.Decimal(10, 7)
  longitude  Decimal?          @db.Decimal(10, 7)
  plusCode   String?
  addressAr  String?
  addressFr  String?
  isVerified Boolean           @default(false)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([areaId])
  @@index([isActive])
  @@index([type])
  @@index([latitude, longitude])
}

/// FCM (Firebase Cloud Messaging) push token bound to a single device of a user.
/// One row per (user, device). On reinstall / re-login the same token may
/// appear under a different user â€” the UNIQUE constraint on `token` guarantees
/// a single owner, and re-registering from the new account simply reassigns
/// the row (we update userId + updatedAt on the existing record instead of
/// creating a duplicate).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // 'android' | 'ios' | 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
